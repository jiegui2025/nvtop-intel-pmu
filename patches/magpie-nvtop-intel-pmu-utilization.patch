diff --git a/src/extract_gpuinfo_intel.c b/src/extract_gpuinfo_intel.c
index 6653b5c..d202230 100644
--- a/src/extract_gpuinfo_intel.c
+++ b/src/extract_gpuinfo_intel.c
@@ -64,6 +64,19 @@ static struct gpu_info_intel *gpu_infos;
 // Discrete GPU are others
 #define INTEGRATED_I915_GPU_PCI_ID "0000:00:02.0"
 
+static void get_pmu_name(const struct gpu_info_intel *gpu_info, char *pmu_name, size_t pmu_name_size) {
+  if (gpu_info->driver == DRIVER_I915 && strcmp(gpu_info->base.pdev, INTEGRATED_I915_GPU_PCI_ID) == 0) {
+    // The integrated i915 PMU has no PCI address suffix.
+    snprintf(pmu_name, pmu_name_size, "i915");
+  } else {
+    snprintf(pmu_name, pmu_name_size, gpu_info->driver == DRIVER_XE ? "xe_%s" : "i915_%s", gpu_info->base.pdev);
+  }
+  for (char *ch = pmu_name; *ch; ++ch) {
+    if (*ch == ':')
+      *ch = '_';
+  }
+}
+
 void init_extract_gpuinfo_intel(void) { register_gpu_vendor(&gpu_vendor_intel); }
 
 bool gpuinfo_intel_init(void) { return true; }
@@ -72,6 +85,7 @@ void gpuinfo_intel_shutdown(void) {
     struct gpu_info_intel *current = &gpu_infos[i];
     if (current->card_fd)
       close(current->card_fd);
+    intel_pmu_close(&current->engine_pmu);
     nvtop_device_unref(current->card_device);
     nvtop_device_unref(current->driver_device);
   }
@@ -109,6 +123,7 @@ static void add_intel_cards(struct nvtop_device *dev, struct list_head *devices,
   thisGPU->card_device = nvtop_device_ref(dev);
   thisGPU->driver_device = nvtop_device_ref(parent);
   thisGPU->hwmon_device = nvtop_device_get_hwmon(thisGPU->driver_device);
+  intel_pmu_initialize(&thisGPU->engine_pmu);
 
   const char *devname;
   if (nvtop_device_get_devname(thisGPU->card_device, &devname) >= 0)
@@ -224,6 +239,26 @@ void gpuinfo_intel_refresh_dynamic_info(struct gpu_info *_gpu_info) {
 
   RESET_ALL(dynamic_info->valid);
 
+  if (!is_xe) {
+    if (!gpu_info->engine_pmu_open_attempted) {
+      char pmu_name[32];
+      get_pmu_name(gpu_info, pmu_name, sizeof(pmu_name));
+      intel_pmu_open(&gpu_info->engine_pmu, pmu_name);
+      gpu_info->engine_pmu_open_attempted = true;
+    }
+
+    struct intel_pmu_utilization utilization;
+    intel_pmu_read(&gpu_info->engine_pmu, &utilization);
+    if (utilization.valid[intel_pmu_engine_render])
+      SET_GPUINFO_DYNAMIC(dynamic_info, gpu_util_rate, utilization.percent[intel_pmu_engine_render]);
+    if (utilization.valid[intel_pmu_engine_video]) {
+      // i915 exposes a shared video engine busy counter, not separate encode
+      // and decode counters. Keep both fields consistent with fdinfo handling.
+      SET_GPUINFO_DYNAMIC(dynamic_info, encoder_rate, utilization.percent[intel_pmu_engine_video]);
+      SET_GPUINFO_DYNAMIC(dynamic_info, decoder_rate, utilization.percent[intel_pmu_engine_video]);
+    }
+  }
+
   // We are creating new devices because the device_get_sysattr_value caches its queries
   const char *syspath;
   nvtop_device *card_dev_noncached = NULL;
